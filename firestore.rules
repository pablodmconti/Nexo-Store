rules_version = '2';

// =====================================================================
// Reglas de seguridad de Cloud Firestore
// ---------------------------------------------------------------------
// Reemplazan el "modo de prueba". Ocultar un botón en el navegador no
// protege nada: estas reglas las aplica Firebase en el servidor, así
// que valen aunque alguien escriba en la base por fuera del sitio.
//
// Se copian en la consola de Firebase:
//   Firestore Database → Reglas → pegar este archivo → Publicar
//
// Todo lo que no está permitido acá queda prohibido.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Funciones de ayuda
    // ---------------------------------------------------------------

    // Hay una persona que inició sesión
    function haySesion() {
      return request.auth != null;
    }

    // El rol se lee del documento usuarios/{uid} de quien hace la
    // operación, igual que en admin.js y navbar.js. exists() evita un
    // error con una cuenta que todavía no tiene ese documento.
    function esAdmin() {
      return haySesion()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    // La operación cambia SOLO los campos de la lista
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Lo que hace confirmarPedido() (pedidos.js) al comprar: baja el
    // stock de un producto disponible SOLO junto con un pedido nuevo.
    // El producto anota el id de ese pedido en ultimoPedido y la regla
    // comprueba que:
    //   - el pedido no existía y se crea en esta misma operación
    //     (exists() mira la base antes de escribir; getAfter(), cómo
    //     queda después),
    //   - es de quien está comprando,
    //   - el stock baja exactamente la cantidad que figura en el pedido,
    //   - no cambia ningún otro campo y el stock no queda negativo.
    // Sin un pedido nuevo, nadie puede bajar el stock por su cuenta.
    function bajaStockConPedidoNuevo(idProducto) {
      let idPedido = request.resource.data.ultimoPedido;
      let rutaPedido = /databases/$(database)/documents/pedidos/$(idPedido);
      let pedido = getAfter(rutaPedido).data;
      let stockAntes = resource.data.stock;
      let stockDespues = request.resource.data.stock;

      return haySesion()
        && soloCambia(["stock", "ultimoPedido"])
        && resource.data.disponible == true
        && idPedido is string
        && stockDespues is int
        && stockDespues >= 0
        && stockDespues < stockAntes
        && !exists(rutaPedido)
        && pedido.uid == request.auth.uid
        && pedido.cantidades[idProducto] == stockAntes - stockDespues;
    }

    // Lo que arma confirmarPedido() (pedidos.js): un pedido nuevo con
    // exactamente estos campos, a nombre de quien compra, con la hora
    // del servidor, pendiente y con cuentas que cierran. El envío se
    // vuelve a calcular con los montos de calcularEnvio() (base.js):
    // gratis desde $ 2000, si no $ 290.
    function pedidoNuevoValido(idPedido) {
      let pedido = request.resource.data;
      let campos = ["uid", "nombreUsuario", "correo", "productos", "cantidades",
                    "subtotal", "envio", "total", "fecha", "estado", "pago"];

      return pedido.keys().hasOnly(campos)
        && pedido.keys().hasAll(campos)
        && pedido.uid == request.auth.uid
        && pedido.correo == request.auth.token.email
        && pedido.nombreUsuario is string
        && pedido.nombreUsuario.size() > 0
        && pedido.fecha == request.time
        && pedido.estado == "pendiente"
        && pedido.pago.keys().hasOnly(["metodo", "estado"])
        && pedido.pago.metodo in ["simulado", "coordinar"]
        && pedido.pago.estado == "pendiente"
        && productosDelPedidoValidos(pedido, idPedido)
        && pedido.subtotal == sumaDeSubtotales(pedido.productos)
        && pedido.envio == (pedido.subtotal >= 2000 ? 0 : 290)
        && pedido.total == pedido.subtotal + pedido.envio;
    }

    // Las reglas no tienen bucles: por eso la compra admite hasta 5
    // productos distintos (MAXIMO_PRODUCTOS_CARRITO en base.js) y cada
    // posición de la lista se revisa por separado.
    // La lista y cantidades tienen que hablar EXACTAMENTE de los mismos
    // productos: ningún id repetido en la lista y ninguna clave de más
    // en cantidades. Si no, un pedido con { p1, p1 } en la lista y
    // { p1, p2 } en cantidades dejaría descontar stock de p2 sin
    // comprarlo (bajaStockConPedidoNuevo solo mira cantidades).
    function productosDelPedidoValidos(pedido, idPedido) {
      let lista = pedido.productos;
      let ids = idsDeLaLista(lista);

      return lista is list
        && lista.size() >= 1
        && lista.size() <= 5
        && ids.toSet().size() == lista.size()
        && pedido.cantidades is map
        && pedido.cantidades.size() == lista.size()
        && pedido.cantidades.keys().hasOnly(ids)
        && productoDelPedidoValido(pedido, 0, idPedido)
        && (lista.size() < 2 || productoDelPedidoValido(pedido, 1, idPedido))
        && (lista.size() < 3 || productoDelPedidoValido(pedido, 2, idPedido))
        && (lista.size() < 4 || productoDelPedidoValido(pedido, 3, idPedido))
        && (lista.size() < 5 || productoDelPedidoValido(pedido, 4, idPedido));
    }

    // Un producto del pedido se compara con el producto REAL tal como
    // queda después de la compra (getAfter):
    //   - tiene que haber anotado este pedido en ultimoPedido, o sea que
    //     su stock bajó en esta misma operación (ver
    //     bajaStockConPedidoNuevo, que exige que baje esta cantidad),
    //   - el nombre y el precio son los de la tienda,
    //   - la cantidad es un entero positivo, igual a la de cantidades,
    //   - el subtotal es precio × cantidad.
    function productoDelPedidoValido(pedido, i, idPedido) {
      let item = pedido.productos[i];
      let producto = getAfter(/databases/$(database)/documents/productos/$(item.idProducto)).data;

      return item.keys().hasOnly(["idProducto", "nombre", "precioUnitario", "cantidad", "subtotal"])
        && item.cantidad is int
        && item.cantidad > 0
        && pedido.cantidades[item.idProducto] == item.cantidad
        && producto.ultimoPedido == idPedido
        && item.nombre == producto.nombre
        && item.precioUnitario == producto.precio
        && item.subtotal == item.precioUnitario * item.cantidad;
    }

    // Los idProducto de la lista (hasta 5), como una lista nueva:
    // ["p1"].concat(["p3"]).concat([]) ... = ["p1", "p3"]
    function idEn(lista, i) {
      return i < lista.size() ? [lista[i].idProducto] : [];
    }

    function idsDeLaLista(lista) {
      return idEn(lista, 0).concat(idEn(lista, 1)).concat(idEn(lista, 2))
        .concat(idEn(lista, 3)).concat(idEn(lista, 4));
    }

    // La suma de los subtotales de la lista (hasta 5 productos).
    // condición ? valor : otro elige un valor según la condición.
    function subtotalEn(lista, i) {
      return i < lista.size() ? lista[i].subtotal : 0;
    }

    function sumaDeSubtotales(lista) {
      return subtotalEn(lista, 0) + subtotalEn(lista, 1) + subtotalEn(lista, 2)
        + subtotalEn(lista, 3) + subtotalEn(lista, 4);
    }

    // Lo que hace registrarPago() (pedidos.js) al volver de la pasarela
    // simulada: el dueño de un pedido pendiente con pago en línea cambia
    // SOLO el campo pago, a "aprobado" o "rechazado", con un número de
    // operación SIM-123... Un pago aprobado ya no se puede cambiar.
    function registraPagoEnLinea() {
      return haySesion()
        && resource.data.uid == request.auth.uid
        && resource.data.estado == "pendiente"
        && resource.data.pago.metodo == "simulado"
        && resource.data.pago.estado != "aprobado"
        && soloCambia(["pago"])
        && request.resource.data.pago.metodo == "simulado"
        && request.resource.data.pago.estado in ["aprobado", "rechazado"]
        && request.resource.data.pago.idOperacion is string
        && request.resource.data.pago.idOperacion.matches("SIM-[0-9]+");
    }

    // ---------------------------------------------------------------
    // usuarios/{uid}
    // Cada persona lee solo su documento (el administrador, todos).
    // Al registrarse entra siempre como "cliente" y nadie puede
    // cambiarse el rol desde el sitio: "admin" se asigna a mano en la
    // consola de Firebase.
    // ---------------------------------------------------------------
    match /usuarios/{uid} {
      allow read: if haySesion() && (request.auth.uid == uid || esAdmin());

      allow create: if haySesion()
        && request.auth.uid == uid
        && request.resource.data.rol == "cliente";

      allow update: if haySesion()
        && request.auth.uid == uid
        && request.resource.data.rol == resource.data.rol;

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // productos/{idProducto}
    // Lectura pública: el catálogo se ve sin iniciar sesión.
    // Crear, editar y eliminar: solo administradores.
    // Única excepción: el descuento de stock de una compra.
    // (La compra se comprueba primero: así un cliente no gasta lecturas
    // en esAdmin() y la compra no se acerca al límite de get()/exists()
    // de Firestore.)
    // ---------------------------------------------------------------
    match /productos/{idProducto} {
      allow read: if true;
      allow create, delete: if esAdmin();
      allow update: if bajaStockConPedidoNuevo(idProducto) || esAdmin();
    }

    // ---------------------------------------------------------------
    // pedidos/{idPedido}
    // Cada cliente lee solo sus pedidos; el administrador, todos.
    // Un pedido nuevo lo crea solo un cliente (una cuenta de
    // administración no compra) y tiene que coincidir con lo que pasa
    // en la tienda en esa misma compra: productos, precios, cantidades,
    // stock descontado y totales (ver pedidoNuevoValido). El estado lo
    // cambia solo el administrador; el cliente solo registra su pago.
    // ---------------------------------------------------------------
    match /pedidos/{idPedido} {
      allow read: if haySesion()
        && (resource.data.uid == request.auth.uid || esAdmin());

      allow create: if haySesion()
        && !esAdmin()
        && pedidoNuevoValido(idPedido);

      allow update: if esAdmin() || registraPagoEnLinea();

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // valoraciones/{idProducto_uid}
    // Lectura pública (las opiniones se ven en la ficha).
    // Cada persona escribe solo SU opinión, con los mismos límites que
    // validarValoracion() en valoraciones.js. El administrador puede
    // borrar una opinión inapropiada.
    // ---------------------------------------------------------------
    match /valoraciones/{idValoracion} {
      allow read: if true;

      allow create, update: if haySesion()
        && request.resource.data.uid == request.auth.uid
        && idValoracion == request.resource.data.idProducto + "_" + request.auth.uid
        && request.resource.data.puntuacion is int
        && request.resource.data.puntuacion >= 1
        && request.resource.data.puntuacion <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() >= 10
        && request.resource.data.comentario.size() <= 500;

      allow delete: if esAdmin();
    }
  }
}
