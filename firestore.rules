rules_version = '2';

// =====================================================================
// Reglas de seguridad de Cloud Firestore · Nivel 99 (Sprint 4)
// ---------------------------------------------------------------------
// Reemplazan el "modo de prueba". Ocultar un botón en el navegador no
// protege nada: estas reglas las aplica Firebase en el servidor, así
// que valen aunque alguien escriba en la base por fuera del sitio.
//
// Se copian en la consola de Firebase:
//   Firestore Database → Reglas → pegar este archivo → Publicar
//
// Todo lo que no está permitido acá queda prohibido.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Funciones de ayuda
    // ---------------------------------------------------------------

    // Hay una persona que inició sesión
    function haySesion() {
      return request.auth != null;
    }

    // El rol se lee del documento usuarios/{uid} de quien hace la
    // operación, igual que en admin.js y navbar.js. exists() evita un
    // error con una cuenta que todavía no tiene ese documento.
    function esAdmin() {
      return haySesion()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    // La operación cambia SOLO los campos de la lista
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Lo que hace confirmarPedido() (pedidos.js) al comprar: descuenta
    // stock de un producto disponible, sin tocar nada más y sin dejarlo
    // en negativo
    function descuentaStockAlComprar() {
      return haySesion()
        && soloCambia(["stock"])
        && resource.data.disponible == true
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }

    // Lo que hace registrarPago() (pedidos.js) al volver de Mercado
    // Pago: el dueño de un pedido pendiente con Mercado Pago cambia SOLO
    // el campo pago, con el resultado y el número de pago (payment_id).
    // Un pago aprobado ya no se puede cambiar.
    function registraPagoMercadoPago() {
      return haySesion()
        && resource.data.uid == request.auth.uid
        && resource.data.estado == "pendiente"
        && resource.data.pago.metodo == "mercadopago"
        && resource.data.pago.estado != "aprobado"
        && soloCambia(["pago"])
        && request.resource.data.pago.metodo == "mercadopago"
        && request.resource.data.pago.estado in ["aprobado", "rechazado", "en proceso"]
        && request.resource.data.pago.idOperacion is string
        && request.resource.data.pago.idOperacion.matches("[0-9]+");
    }

    // ---------------------------------------------------------------
    // usuarios/{uid}
    // Cada persona lee solo su documento (el administrador, todos).
    // Al registrarse entra siempre como "cliente" y nadie puede
    // cambiarse el rol desde el sitio: "admin" se asigna a mano en la
    // consola de Firebase.
    // ---------------------------------------------------------------
    match /usuarios/{uid} {
      allow read: if haySesion() && (request.auth.uid == uid || esAdmin());

      allow create: if haySesion()
        && request.auth.uid == uid
        && request.resource.data.rol == "cliente";

      allow update: if haySesion()
        && request.auth.uid == uid
        && request.resource.data.rol == resource.data.rol;

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // productos/{idProducto}
    // Lectura pública: el catálogo se ve sin iniciar sesión.
    // Crear, editar y eliminar: solo administradores.
    // Única excepción: el descuento de stock de una compra.
    // ---------------------------------------------------------------
    match /productos/{idProducto} {
      allow read: if true;
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || descuentaStockAlComprar();
    }

    // ---------------------------------------------------------------
    // pedidos/{idPedido}
    // Cada cliente lee solo sus pedidos; el administrador, todos.
    // Un pedido nuevo lo crea solo un cliente (una cuenta de
    // administración no compra), a su nombre, como "pendiente" y con el
    // pago también pendiente. El estado lo cambia solo el administrador;
    // el cliente solo registra su pago.
    // ---------------------------------------------------------------
    match /pedidos/{idPedido} {
      allow read: if haySesion()
        && (resource.data.uid == request.auth.uid || esAdmin());

      allow create: if haySesion()
        && !esAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == "pendiente"
        && request.resource.data.pago.metodo in ["mercadopago", "coordinar"]
        && request.resource.data.pago.estado == "pendiente";

      allow update: if esAdmin() || registraPagoMercadoPago();

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // valoraciones/{idProducto_uid}
    // Lectura pública (las opiniones se ven en la ficha).
    // Cada persona escribe solo SU opinión, con los mismos límites que
    // validarValoracion() en valoraciones.js. El administrador puede
    // borrar una opinión inapropiada.
    // ---------------------------------------------------------------
    match /valoraciones/{idValoracion} {
      allow read: if true;

      allow create, update: if haySesion()
        && request.resource.data.uid == request.auth.uid
        && idValoracion == request.resource.data.idProducto + "_" + request.auth.uid
        && request.resource.data.puntuacion is int
        && request.resource.data.puntuacion >= 1
        && request.resource.data.puntuacion <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() >= 10
        && request.resource.data.comentario.size() <= 500;

      allow delete: if esAdmin();
    }
  }
}
